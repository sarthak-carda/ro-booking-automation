# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3000

# --- Stage 2 (script conversion) ---
# Real key required for live script generation. Without it, the pipeline falls
# back to a deterministic mock generator (see src/openai/client.js) so the rest
# of the pipeline (audit, ship, self-heal, threshold) still runs end to end.
OPENAI_API_KEY=
# Any OpenAI model your key has access to. gpt-5.6-sol per your call — this
# name is outside Claude's training data (cutoff Jan 2026), so it's unverified
# until the first real API call against your key confirms it. Once
# OPENAI_API_KEY is set, verify with:
#   curl https://api.openai.com/v1/models/gpt-5.6-sol -H "Authorization: Bearer $OPENAI_API_KEY"
# A 200 with the model's details confirms it; a 404 means override this to
# whatever `curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"` lists instead.
OPENAI_MODEL=gpt-5.6-sol

# --- Threshold job (Stage 0-4 trigger) ---
# Manual-ticket count per vendor/tour that triggers script-creation eligibility.
AUTOMATION_THRESHOLD=30

# --- Keeper (vendor credentials) ---
# Stubbed with fixtures/keeper/test-credentials.json until real Keeper access
# is wired up. Never put a real credential in this file or in fixtures/.
KEEPER_STUB=true

# --- Zendesk (manual-ticket volume pull) ---
# Stubbed with fixtures/zendesk-tickets.fixture.json until a real pull is wired up.
ZENDESK_STUB=true

# --- bakeoff/ (Stage 1 capture-tool comparison — see bakeoff/README.md) ---
# Only needed for whichever tool(s) you're actually comparing; each adapter
# reports "not_configured" and costs nothing if its key is left blank.
# These are read via the SAME loader as everything above (app/config.py),
# and inherited automatically by the in-process adapters and the adapter
# subprocesses (Python/Node) that bakeoff/run_bakeoff.py spawns — one file,
# nothing extra to configure.

# browser-use and Stagehand both reuse OPENAI_API_KEY above; ANTHROPIC_API_KEY
# is an optional alternative for Stagehand only. claude-devtools (the fifth
# capture tool, Claude + the official Chrome DevTools MCP server) REQUIRES a
# real ANTHROPIC_API_KEY — there is no OpenAI fallback for it, since it's
# specifically evaluating Claude as the driving agent.
ANTHROPIC_API_KEY=
BROWSER_USE_MODEL=gpt-4.1
STAGEHAND_MODEL=openai/gpt-4.1
# Model claude-devtools uses as its driving agent; defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Skyvern: cloud key (skyvern.com), or self-hosted — see bakeoff/README.md.
SKYVERN_API_KEY=
SKYVERN_BASE_URL=https://api.skyvern.com
# Only needed for a vendor that requires login — create the credential in
# Skyvern's vault first; never pass raw username/password to it directly.
SKYVERN_CREDENTIAL_ID=

# Firecrawl ("Prometheus") — lowest-confidence adapter, see bakeoff/README.md.
FIRECRAWL_API_KEY=
